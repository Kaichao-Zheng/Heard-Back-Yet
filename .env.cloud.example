# PostgreSQL container and connection config
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=heardbackyet
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Endpoint and model config
# MODEL_PROVIDER=ollama
MODEL_PROVIDER=alibaba_model_studio

OLLAMA_URL=http://host.docker.internal:11434
MODEL_BASE_URL=https://your-openai-compatible-endpoint.example/v1
MODEL_API_KEY=

TEXT_CLASSIFICATION_MODEL=qwen3.7-plus
ENTITY_EXTRACTION_MODEL=qwen3.7-plus
EMBEDDING_MODEL=qwen3.7-text-embedding
INTENT_CLASSIFICATION_MODEL=qwen3.7-plus
RESPONSE_GENERATION_MODEL=qwen3.7-plus

# Cloudflare Pages frontend and the Cloudflare-proxied public API origin.
FRONTEND_API_BASE_URL=https://api.example.com
API_ALLOWED_FRONTEND_ORIGINS=https://app.example.com

# HTTP origin hostname received by Nginx behind Cloudflare Flexible SSL.
API_DOMAIN=api.example.com
